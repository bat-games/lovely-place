{
    "explorer.excludeGitIgnore": false,
    "files.exclude": {
        "**/.git": true,
        "**/.DS_Store": true,
        "**/.vs": true,
        "**/Library": true,
        "**/Temp": true,
        "**/Obj": true,
        "**/Logs": true,
        "**/UserSettings": true,
        "**/Build": true,
        "**/Builds": true,
        "**/*.csproj": true,
        "**/*.sln": true,
        "**/*.slnx": true,
        "**/*.unityproj": true,
        "**/*.suo": true,
        "**/*.user": true,
        "**/*.userprefs": true,
        "**/*.pidb": true,
        "**/*.booproj": true,
        "**/*.tmp": true,
        "**/*.log": true,
        "**/*.meta": true,
        "**/*.asset": true,
        "**/*.prefab": true,
        "**/*.unity": true,
        "**/*.mat": true,
        "**/*.anim": true,
        "**/*.controller": true,
        "**/*.{png,jpg,jpeg,gif,ico,psd,tga,tif,tiff}": true,
        "**/*.{fbx,blend,obj,3ds}": true,
        "**/*.{wav,mp3,ogg,mp4}": true
    },
    "files.associations": {
        "*.asmdef": "json",
        "*.asmref": "json",
        "*.shader": "hlsl",
        "*.compute": "hlsl",
        "*.hlsl": "hlsl",
        "*.cginc": "hlsl"
    },
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.formatOnSave": true,
    "explorer.fileNesting.enabled": false
}